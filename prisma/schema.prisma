generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Activity {
  id          String   @id @default(cuid())
  type        String
  timestamp   DateTime
  title       String
  description String?
  url         String?
  metadata    Json?
  createdAt   DateTime @default(now())
  
  @@index([timestamp])
}
